<file path="frontend/components/IntelligencePanel.tsx">
"use client";

import { useEffect, useState } from "react";
import {
  ReactFlow,
  Background,
  Controls,
  MiniMap,
  Node,
  Edge,
} from "@xyflow/react";

import "@xyflow/react/dist/style.css";

interface GraphResponse {
  nodes: {
    id: string;
    label: string;
  }[];
  edges: {
    source: string;
    target: string;
  }[];
}

export default function GraphStage() {
  const [nodes, setNodes] = useState<Node[]>([]);
  const [edges, setEdges] = useState<Edge[]>([]);

  useEffect(() => {
    async function loadGraph() {
      try {
        const res = await fetch("http://127.0.0.1:8000/api/graph");

        if (!res.ok) return;

        const data: GraphResponse = await res.json();

        const graphNodes: Node[] = data.nodes.map((node, index) => ({
          id: node.id,
          position: {
            x: (index % 6) * 220,
            y: Math.floor(index / 6) * 150,
          },
          data: {
            label: node.label,
          },
        }));

        const graphEdges: Edge[] = data.edges.map((edge, index) => ({
          id: `e-${index}`,
          source: edge.source,
          target: edge.target,
          animated: true,
        }));

        setNodes(graphNodes);
        setEdges(graphEdges);
      } catch (err) {
        console.error(err);
      }
    }

    loadGraph();
  }, []);

  return (
    <div className="rounded-xl bg-slate-900 p-5 shadow-xl">
      <h2 className="mb-4 text-2xl font-bold text-cyan-300">
        Government Contract Network
      </h2>

      <div className="h-[650px] w-full rounded-lg overflow-hidden">
        <ReactFlow nodes={nodes} edges={edges} fitView>
          <Background />
          <MiniMap />
          <Controls />
        </ReactFlow>
      </div>
    </div>
  );
}
