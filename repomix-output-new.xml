        <svg
          width="260"
          height="260"
          viewBox="0 0 260 260"
        >
          <g transform="translate(130,130)">

            {data.map((item) => {

              const sweep =
                (item.value / 100) * 360;

              const path = describeArc(
                0,
                0,
                90,
                startAngle,
                startAngle + sweep
              );

              startAngle += sweep;

              return (
                <path
                  key={item.label}
                  d={path}
                  stroke={item.color}
                  strokeWidth="30"
                  fill="none"
                  strokeLinecap="round"
                />
              );
            })}

            <text
              textAnchor="middle"
              y="-8"
