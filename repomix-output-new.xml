app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],      # Change this to your frontend URL in production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# -----------------------------
# Root Endpoint
# -----------------------------
@app.get("/")
def home():
    return {
        "project": "Government Spending Contract Graph",
        "developer": "Aswin Sankar P.S.",
        "batch": "Real Rails Intelligence Library - Batch 7",
        "status": "Running",
        "docs": "/docs"
