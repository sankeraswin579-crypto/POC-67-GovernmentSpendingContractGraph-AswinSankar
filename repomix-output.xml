"use client";

import { useEffect, useState } from "react";

type Summary = {
  total_contracts: number;
  total_spending: number;
  agencies: number;
  vendors: number;
};

export default function Dashboard() {
  const [summary, setSummary] = useState<Summary>({
    total_contracts: 0,
    total_spending: 0,
    agencies: 0,
    vendors: 0,
  });

  useEffect(() => {
    async function loadSummary() {
      try {
        const res = await fetch("http://127.0.0.1:8000/api/summary");

        if (!res.ok) return;

        const data = await res.json();

        setSummary({
          total_contracts: data.total_contracts ?? data.rows ?? 0,
          total_spending: data.total_spending ?? 0,
          agencies: data.agencies ?? 0,
          vendors: data.vendors ?? 0,
        });
      } catch (err) {
        console.error(err);
      }
    }

    loadSummary();
  }, []);

  const cards = [
    {
      title: "Contracts",
      value: summary.total_contracts.toLocaleString(),
    },
    {
      title: "Total Spending",
      value: `$${summary.total_spending.toLocaleString()}`,
    },
    {
      title: "Agencies",
      value: summary.agencies.toLocaleString(),
    },
    {
      title: "Vendors",
      value: summary.vendors.toLocaleString(),
    },
  ];

  return (
    <div className="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      {cards.map((card) => (
        <div
          key={card.title}
          className="rounded-xl border border-cyan-500/20 bg-slate-900 p-6 shadow-lg transition hover:border-cyan-400"
        >
          <p className="text-sm text-slate-400">{card.title}</p>

          <h2 className="mt-3 text-3xl font-bold text-cyan-300">
            {card.value}
          </h2>
        </div>
      ))}
    </div>
  );
}
