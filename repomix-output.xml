  async function loadData() {
    try {
      const [summaryRes, contractsRes, analyticsRes] = await Promise.all([
        fetch(`${API}/api/summary`),
        fetch(`${API}/api/contracts`),
        fetch(`${API}/api/analytics`),
      ]);

      const summaryData = await summaryRes.json();
      const contractData = await contractsRes.json();
      const analyticsData = await analyticsRes.json();

      setSummary({
        total_contracts: summaryData.total_contracts ?? 0,
        total_spending: summaryData.total_spending ?? 0,
        agencies: summaryData.agencies ?? 0,
        vendors: summaryData.vendors ?? 0,
      });

      setContracts(contractData);
      setChartData(analyticsData);
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="min-h-screen bg-[#020617] text-white">

      {/* HEADER */}

      <header className="border-b border-cyan-500/20 bg-[#071019]">

        <div className="mx-auto flex max-w-7xl items-center justify-between px-8 py-5">

          <div>
            <h1 className="text-3xl font-black text-cyan-300">
              Government Spending Contract Graph
            </h1>

            <p className="text-slate-400">
              Real Rails Intelligence Library • Batch 7
            </p>
          </div>

          <div className="text-right">
            <p className="text-xs uppercase text-slate-500">
              Developed By
            </p>

            <h2 className="text-xl font-bold text-cyan-300">
              Aswin Sankar P.S.
            </h2>
          </div>

        </div>

      </header>

      <main className="mx-auto max-w-7xl p-8">

        {/* DASHBOARD */}

        <div className="grid gap-6 md:grid-cols-2 xl:grid-cols-4">

          <Card
            title="Contracts"
            value={
              loading
                ? "..."
                : summary.total_contracts.toLocaleString()
            }
          />

          <Card
            title="Total Spending"
            value={
              loading
                ? "..."
                : `$${Number(summary.total_spending).toLocaleString()}`
            }
          />

          <Card
            title="Agencies"
            value={
              loading
                ? "..."
                : summary.agencies.toLocaleString()
            }
          />

          <Card
            title="Vendors"
            value={
              loading
                ? "..."
                : summary.vendors.toLocaleString()
            }
          />

        </div>

        {/* CHART */}

        <div className="mt-10">

          <SpendingChart data={chartData} />

        </div>

        {/* MAP / GRAPH */}

        <div className="mt-10 rounded-2xl overflow-hidden border border-cyan-500/20">

          <MapStage />

        </div>

        {/* TABLE */}

        <div className="mt-10 rounded-2xl border border-cyan-500/20 bg-[#071019] p-6">

          <h2 className="mb-6 text-2xl font-bold text-cyan-300">

            Government Contracts

          </h2>

          <div className="overflow-x-auto">

            <table className="w-full">

              <thead>

                <tr className="border-b border-cyan-500/20">

                  <th className="p-3 text-left">Agency</th>
                  <th className="p-3 text-left">Vendor</th>
                  <th className="p-3 text-left">Contract</th>
                  <th className="p-3 text-left">Amount</th>
                  <th className="p-3 text-left">Year</th>
                  <th className="p-3 text-left">State</th>

                </tr>

              </thead>

              <tbody>

                {contracts.map((item, index) => (

                  <tr
                    key={index}
                    className="border-b border-slate-800 hover:bg-slate-900"
                  >

                    <td className="p-3">{item.agency}</td>

                    <td className="p-3">{item.vendor}</td>

                    <td className="p-3">{item.contract_title}</td>

                    <td className="p-3">
                      ${Number(item.amount).toLocaleString()}
                    </td>

                    <td className="p-3">{item.year}</td>

                    <td className="p-3">{item.state}</td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        </div>

      </main>

    </div>
  );
}

function Card({
  title,
  value,
}: {
  title: string;
  value: string;
}) {
  return (
    <div className="rounded-2xl border border-cyan-500/20 bg-[#071019] p-6">

      <p className="text-xs uppercase tracking-widest text-slate-500">

        {title}

      </p>

      <h2 className="mt-4 text-4xl font-black text-cyan-300">

        {value}

      </h2>

    </div>
  );
}
